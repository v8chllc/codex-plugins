{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/remember/scripts/turn_journal.py\" capture",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/remember/scripts/turn_journal.py\" capture",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
